# Forja OS — variáveis de produção. Copie para `.env` ao lado do docker-compose.prod.yml.
# Sem domínio: usar o IP da VPS + as portas expostas (evitando as do Dokploy: 80/443/3000).

POSTGRES_PASSWORD=troque-esta-senha-forte

# URLs públicas (IP da VPS + portas do host)
NEXT_PUBLIC_API_URL=http://168.231.66.179:8081
WEB_ORIGIN=http://168.231.66.179:8080
WEB_HOST_PORT=8080
API_HOST_PORT=8081

# IA (SiliconFlow / Qwen)
SILICONFLOW_API_KEY=
SILICONFLOW_BASE_URL=https://api.siliconflow.com/v1
SILICONFLOW_MODEL=Qwen/Qwen2.5-72B-Instruct

# Ingestão (urlscan)
URLSCAN_API_KEY=
URLSCAN_QUERY=domain:cdn.utmify.com.br
INGEST_LOOKBACK_DAYS=7
INGEST_MAX_OFFERS=20
INGEST_SCHEDULE_HOURS=6

# Demanda (opcional)
SERPAPI_KEY=
