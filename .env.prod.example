# Forja OS — variáveis de produção. Copie para `.env` ao lado do docker-compose.prod.yml.
# Sem domínio: usar o IP da VPS + as portas expostas (evitando as do Dokploy: 80/443/3000).

POSTGRES_PASSWORD=troque-esta-senha-forte

# URLs públicas (IP da VPS + portas do host)
NEXT_PUBLIC_API_URL=http://168.231.66.179:8081
WEB_ORIGIN=http://168.231.66.179:8080
WEB_HOST_PORT=8080
API_HOST_PORT=8081

# IA (SiliconFlow / Qwen)
AI_PROVIDER=openrouter
AI_FALLBACK_PROVIDER=
AI_OPENAI_API_KEY=
AI_OPENAI_BASE_URL=https://openrouter.ai/api/v1
AI_OPENAI_MODEL=nvidia/nemotron-3-super-120b-a12b:free
AI_DISABLE_REASONING=true
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5

# Colheita do Radar (urlscan) — as fontes vivem no banco (HarvestSource),
# semeadas pelo deploy via prisma/seed-sources.ts.
URLSCAN_API_KEY=

# Demanda (opcional)
SERPAPI_KEY=
