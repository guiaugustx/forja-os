{
  "name": "forja-os",
  "private": true,
  "version": "0.1.0",
  "description": "Forja OS — central de operação de produtos digitais low ticket globais",
  "packageManager": "pnpm@9.12.0",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "start": "turbo run start",
    "db:generate": "pnpm --filter @forja/db generate",
    "db:push": "pnpm --filter @forja/db push",
    "db:migrate": "pnpm --filter @forja/db migrate",
    "db:seed": "pnpm --filter @forja/db seed",
    "db:seed:sources": "pnpm --filter @forja/db seed:sources",
    "db:studio": "pnpm --filter @forja/db studio",
    "infra:up": "docker compose up -d",
    "infra:down": "docker compose down",
    "setup": "bash scripts/setup.sh"
  },
  "devDependencies": {
    "turbo": "^2.1.3",
    "typescript": "^5.5.4",
    "prettier": "^3.3.3",
    "dotenv-cli": "^7.4.2"
  },
  "engines": {
    "node": ">=20"
  }
}
