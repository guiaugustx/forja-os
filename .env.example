# ===== Banco =====
DATABASE_URL="postgresql://forja:forja@localhost:5432/forja?schema=public"

# ===== Redis (filas / worker) =====
REDIS_URL="redis://localhost:6379"

# ===== API =====
API_PORT=3333
WEB_ORIGIN="http://localhost:3000"

# ===== Web =====
NEXT_PUBLIC_API_URL="http://localhost:3333"

# ===== IA (SiliconFlow — compatível com OpenAI; raio-x + modelagem de oferta) =====
SILICONFLOW_API_KEY=""
SILICONFLOW_BASE_URL="https://api.siliconflow.com/v1"
SILICONFLOW_MODEL="Qwen/Qwen2.5-72B-Instruct"

# ===== Ingestão de ofertas (urlscan.io) =====
# Crie uma conta gratuita em https://urlscan.io e gere um API-Key em Settings & API.
URLSCAN_API_KEY=""
# Query da Search API. Default: páginas que carregam o rastreador Utmify (páginas de venda).
URLSCAN_QUERY="domain:cdn.utmify.com.br"
# Janela de busca (dias) e intervalo do agendamento periódico (horas).
INGEST_LOOKBACK_DAYS="7"
INGEST_SCHEDULE_HOURS="6"
# Nº máximo de ofertas processadas por rodada (controla custo de IA / rate limit).
INGEST_MAX_OFFERS="25"
# Dias até re-checar um domínio já processado (avança para links novos entre runs).
INGEST_SEEN_COOLDOWN_DAYS="21"

# ===== Demanda (opcional, adiado) — Google Trends via SerpApi =====
SERPAPI_KEY=""

# ===== Integrações futuras (preencher conforme conecta) =====
# Pagamentos
CAKTO_API_KEY=""
CAKTO_WEBHOOK_SECRET=""
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
HOTMART_CLIENT_ID=""
HOTMART_CLIENT_SECRET=""
# Tráfego
META_ACCESS_TOKEN=""
META_AD_ACCOUNT_IDS=""
TIKTOK_ACCESS_TOKEN=""
# Radar / mineração (Meta Ad Library — sinais reais de anúncio, fase seguinte)
META_AD_LIBRARY_TOKEN=""

