# ===== Banco =====
DATABASE_URL="postgresql://forja:forja@localhost:5432/forja?schema=public"

# ===== Redis (filas / worker) =====
REDIS_URL="redis://localhost:6379"

# ===== API =====
API_PORT=3333
WEB_ORIGIN="http://localhost:3000"

# ===== Web =====
NEXT_PUBLIC_API_URL="http://localhost:3333"

# ===== IA (provedor compatível com OpenAI — raio-x + modelagem de oferta) =====
# ── IA ────────────────────────────────────────────────────────────────
# AI_PROVIDER escolhe quem atende: "openrouter" (ou qualquer API compativel
# com OpenAI) ou "anthropic" (Claude API). Sem declarar, usa o que tiver chave.
# AI_FALLBACK_PROVIDER e opcional e so entra em acao quando o primario recusa
# por COTA ou RATE LIMIT — chave errada ou rede fora falham de forma visivel.
AI_PROVIDER="openrouter"
AI_FALLBACK_PROVIDER=""

# OpenRouter / qualquer API compativel com OpenAI
AI_OPENAI_API_KEY=""
AI_OPENAI_BASE_URL="https://openrouter.ai/api/v1"
AI_OPENAI_MODEL="nvidia/nemotron-3-super-120b-a12b:free"
# Modelos de reasoning truncam/vazam o JSON; desligar da saida direta.
AI_DISABLE_REASONING="true"

# Claude API. Sem temperature (os modelos Opus 5 rejeitam com 400) e com
# thinking ligado por padrao — o cliente ja reserva max_tokens para isso.
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-opus-5"
# Opcional: low | medium | high | xhigh | max. Vazio = padrao da API.
ANTHROPIC_EFFORT=""

# Sem chave de provedor nenhuma, a IA roda em MODO SIMULADO e devolve mocks
# coerentes — o fluxo funciona e o dossie e ficcao. Prefira uma chave errada
# dando erro visivel a uma chave vazia mentindo.

# ===== Colheita do Radar (urlscan.io) =====
# Crie uma conta gratuita em https://urlscan.io e gere um API-Key em Settings & API.
# As fontes (quais queries varrer) vivem no banco (HarvestSource), semeadas por
# `pnpm --filter @forja/db seed:sources` — não há mais query fixa via env.
URLSCAN_API_KEY=""

# ===== Demanda (opcional, adiado) — Google Trends via SerpApi =====
SERPAPI_KEY=""

# ===== Integrações futuras (preencher conforme conecta) =====
# Pagamentos
CAKTO_API_KEY=""
CAKTO_WEBHOOK_SECRET=""
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
HOTMART_CLIENT_ID=""
HOTMART_CLIENT_SECRET=""
# Tráfego
META_ACCESS_TOKEN=""
META_AD_ACCOUNT_IDS=""
TIKTOK_ACCESS_TOKEN=""
# Radar / mineração (Meta Ad Library — sinais reais de anúncio, fase seguinte)
META_AD_LIBRARY_TOKEN=""

# ===== Segredos em produção =====
# Em prod, use Infisical em vez deste arquivo. Veja plano.md, Fase 0.
